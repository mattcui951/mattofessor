{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mattofessor",
  "version": "1.0.2",
  "identifier": "com.matt.mattofessor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/icon.ico": "app.ico"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2NTZENDcwNDk4MUE1NzkKUldSNXBZRkpjTlJXaHY0S056YXFsYVFpWTdSa1FUNDR3eGppTWZ5cmh4a3FyYmNtM2t3dExYaXQK",
      "endpoints": [
        "https://github.com/mattcui951/mattofessor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
